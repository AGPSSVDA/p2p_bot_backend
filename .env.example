# ════════════════════════════════════════════════════════════
#  BINANCE MERCHANT API KEYS  (SAPI v7.4)
#  Apply: https://c2c.binance.com/en/merchantApplication
# ════════════════════════════════════════════════════════════
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key

# ════════════════════════════════════════════════════════════
#  PAN VERIFICATION  (Surepass — optional Phase 2)
#  Endpoint used: https://kyc-api.surepass.app/api/v1/pan/pan
# ════════════════════════════════════════════════════════════
# SUREPASS_TOKEN=your_surepass_jwt_token

# Name match: Surepass returned name vs Binance KYC name
# (falls back to bank account holder name if KYC name not present)
#   PAN_NAME_MATCH_MODE       — 'subset' (default), 'exact', or 'off'
#   PAN_NAME_MISMATCH_BEHAVIOR — 'block' (default, escalate) or 'warn' (log + proceed)
# PAN_NAME_MATCH_MODE=subset
# PAN_NAME_MISMATCH_BEHAVIOR=block

# ════════════════════════════════════════════════════════════
#  AUTO PAYMENT — pick ONE active provider from the dashboard
#  (Overview → Payments → "Active Payment Provider"). Both can be
#  configured at the same time; the dropdown decides which one runs.
# ════════════════════════════════════════════════════════════

# ── Option A: RazorpayX Payouts ──────────────────────────────
#   Docs:  https://razorpay.com/docs/api/x/
#   Auth:  HTTP Basic (key_id : key_secret), JSON payloads.
#   Webhook URL to register in RZP dashboard:
#         https://YOUR-DOMAIN/api/razorpay/webhook
# RAZORPAY_KEY_ID=your_razorpay_key
# RAZORPAY_KEY_SECRET=your_razorpay_secret
# RAZORPAY_ACCOUNT_NUMBER=your_rzpx_virtual_account_number
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Option B: Paywize Payouts (V2 — AES-256-GCM) ─────────────
#   Base URL is overridable (defaults to https://merchant.paywize.in).
#   Auth flow: JWT token from /v1/auth/clients/token (encrypted payload),
#   then AES-256-GCM encrypted payloads on every /payout/v1/* call.
#
#   IMPORTANT — Paywize has NO dashboard webhook URL to register. Instead
#   we pass `callback_url` per request, and Paywize POSTs status updates
#   back to that URL. Set PAYWIZE_CALLBACK_URL to your public webhook URL,
#   OR set APP_PUBLIC_URL and the code derives <APP_PUBLIC_URL>/api/paywize/webhook.
# PAYWIZE_API_KEY=your_paywize_api_key
# PAYWIZE_SECRET_KEY=your_paywize_secret_key
# PAYWIZE_WALLET_ID=your_paywize_wallet_id
# PAYWIZE_WEBHOOK_SECRET=leave_blank_to_reuse_secret_key_for_HMAC
# PAYWIZE_BASE_URL=https://merchant.paywize.in
# PAYWIZE_CALLBACK_URL=https://your-domain.com/api/paywize/webhook
# APP_PUBLIC_URL=https://your-domain.com

# ════════════════════════════════════════════════════════════
#  CONFIGURABLE BOT MESSAGES   (Req #1, #6)
#  Placeholders: {sellerName} {amount} {asset} {cryptoAmount} {orderNo}
#  Use \n in .env for newlines.
# ════════════════════════════════════════════════════════════
# WELCOME_MESSAGE=Thanks for choosing us, kindly enter your PAN card number
# PAN_REQUEST_MESSAGE=Please type your 10-digit PAN. Format: ABCDE1234F
# THANK_YOU_MESSAGE=🎉 Thanks for trading with us! {cryptoAmount} {asset} sent.

# ════════════════════════════════════════════════════════════
#  BOT SETTINGS
# ════════════════════════════════════════════════════════════
ORDER_POLL_INTERVAL=8000
COMPLETION_POLL_INTERVAL=15000
PAN_TIMEOUT_MS=600000
PAN_REMINDER_MS=300000
MAX_PAN_RETRIES=3
# Max times we ask the seller to resubmit their bank account number + IFSC
# in chat (fires when KYC ↔ Bank Holder mismatches but PAN ↔ KYC passes).
MAX_BANK_RETRIES=2
# Auto-pay safety cap is derived as neft_max_amount × 50 from bot_config.
# Configure IMPS / NEFT / RTGS limits from the Payments page in the dashboard.
TDS_PERCENT=1
TAN=JDHT04147D
NODE_ENV=development
LOG_LEVEL=info

# Auto-cancel orders this many ms BEFORE Binance's deadline (default 60000 = 1 min)
# Set to 0 to disable proactive cancellation.
AUTO_CANCEL_BUFFER_MS=60000



